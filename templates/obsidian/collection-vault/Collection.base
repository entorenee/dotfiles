filters:
  and:
    - file.inFolder("Releases")
properties:
  catno:
    displayName: Cat. no.
  condition:
    displayName: Condition (media)
  discogs:
    displayName: Discogs
  sleeve:
    displayName: Sleeve
  price:
    displayName: Price
  source:
    displayName: Got it from
views:
  - type: table
    name: By artist
    groupBy:
      property: note.artist
      direction: ASC
    order:
      - file.name
      - year
      - format
      - source
      - pressing
      - condition
  - type: table
    name: Vinyl
    filters:
      and:
        - 'format == "vinyl"'
    groupBy:
      property: note.artist
      direction: ASC
    order:
      - file.name
      - year
      - source
      - pressing
      - label
      - catno
      - condition
      - sleeve
      - acquired
      - price
      - discogs
  - type: table
    name: CD
    filters:
      and:
        - 'format == "cd"'
    groupBy:
      property: note.artist
      direction: ASC
    order:
      - file.name
      - year
      - source
      - pressing
      - label
      - catno
      - condition
      - price
  - type: table
    name: Digital
    filters:
      and:
        - 'format == "digital"'
    groupBy:
      property: note.artist
      direction: ASC
    order:
      - file.name
      - year
      - source
      - acquired
      - price
  - type: table
    name: By source
    groupBy:
      property: note.source
      direction: ASC
    order:
      - file.name
      - format
      - acquired
      - price
  - type: table
    name: Needs review
    filters:
      or:
        - acquired.isEmpty()
        - source.isEmpty()
    groupBy:
      property: format
      direction: ASC
    order:
      - file.name
      - source
      - condition
      - acquired
